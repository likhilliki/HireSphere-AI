        "jsCode": "// 1. Get the raw text from the AI\nconst rawResponse = $input.item.json.output || $input.item.json.text || \"\"; \n\ntry {\n  // 2. Extract only the JSON part (ignores the \"I cannot...\" text)\n  const jsonMatch = rawResponse.match(/\\{[\\s\\S]*\\}/);\n  const aiResult = JSON.parse(jsonMatch[0]);\n\n  // 3. REACH BACK to your Google Sheets node\n  // Ensure \"Google Form Trigger\" matches your first node's name exactly\n  const triggerData = $node[\"Google Form Trigger\"].json; \n\n  // 4. Merge them together so \"full name\" is available again\n  return {\n    ...triggerData, \n    ...aiResult\n  };\n\n} catch (error) {\n  // 5. Fallback if the AI fails\n  return {\n    ...$node[\"Google Form Trigger\"].json,\n    score: 0,\n    decision: \"Fail\",\n    error_msg: \"AI returned invalid JSON\"\n  };\n}\n"
      },
